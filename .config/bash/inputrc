# Kevin's readline config (bash), mirrors the zsh completion/keybindings
$include /etc/inputrc

set bell-style none
set editing-mode emacs

# Completion
set completion-ignore-case on
set completion-map-case on
set show-all-if-ambiguous on
set colored-stats on
set colored-completion-prefix on
set visible-stats on
set mark-symlinked-directories on
set menu-complete-display-prefix on
set skip-completed-text on

# Tab cycles through matches (like zsh menu select), Shift+Tab goes back
TAB: menu-complete
"\e[Z": menu-complete-backward

# Up/Down search history by what's already typed
"\e[A": history-search-backward
"\e[B": history-search-forward
"\eOA": history-search-backward
"\eOB": history-search-forward

# Home / End / Insert / Delete
"\e[1~": beginning-of-line
"\e[7~": beginning-of-line
"\e[H": beginning-of-line
"\eOH": beginning-of-line
"\e[4~": end-of-line
"\e[8~": end-of-line
"\e[F": end-of-line
"\eOF": end-of-line
"\e[2~": overwrite-mode
"\e[3~": delete-char

# Page up / down: history prefix search too
"\e[5~": history-search-backward
"\e[6~": history-search-forward

# Ctrl+Left / Ctrl+Right move by word
"\e[1;5D": backward-word
"\e[1;5C": forward-word
"\eOd": backward-word
"\eOc": forward-word

# Ctrl+Backspace deletes previous word
"\C-h": backward-kill-word
